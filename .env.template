# ============================================================
# AI Growth OS — Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================

APP_NAME="AI Growth OS"
APP_ENV=development            # development | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Token encryption key (Fernet, urlsafe-base64, 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# OAuth `state` signing secret (HMAC-SHA256; CSRF protection for the Meta callback).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=
OAUTH_STATE_TTL_SECONDS=600

# Auth (SPRINT-04) — AUTH_JWT_SECRET >= 32 bytes, required outside development.
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=
AUTH_ALLOWED_ORIGINS=

# Database (PostgreSQL 16+ with pgvector — ARCHITECTURE_LOCK D-032)
# Values below match docker-compose.yml defaults (development only — override for real envs).
POSTGRES_USER=aigos
POSTGRES_PASSWORD=aigos_dev_only
POSTGRES_DB=ai_growth_os
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aigos:aigos_dev_only@localhost:5432/ai_growth_os
# Integration tests only (pytest -m integration); leave empty to skip them.
TEST_DATABASE_URL=

# Meta Graph API (Facebook / Instagram Business)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/social/meta/callback
# Read-only scopes by default. Publishing scopes are added in a later sprint after App Review.
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,instagram_basic
