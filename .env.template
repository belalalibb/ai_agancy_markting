# ============================================================
# AI Growth OS — Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================

APP_NAME="AI Growth OS"
APP_ENV=development            # development | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Token encryption key (Fernet, urlsafe-base64, 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# OAuth `state` signing secret (HMAC-SHA256; CSRF protection for the Meta callback).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=
OAUTH_STATE_TTL_SECONDS=600

# Auth (SPRINT-04) — AUTH_JWT_SECRET >= 32 bytes, required outside development.
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=
AUTH_ALLOWED_ORIGINS=

# Database (PostgreSQL 16+ with pgvector — ARCHITECTURE_LOCK D-032)
# Values below match docker-compose.yml defaults (development only — override for real envs).
POSTGRES_USER=aigos
POSTGRES_PASSWORD=aigos_dev_only
POSTGRES_DB=ai_growth_os
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aigos:aigos_dev_only@localhost:5432/ai_growth_os
# Integration tests only (pytest -m integration); leave empty to skip them.
TEST_DATABASE_URL=

# Meta Graph API (Facebook / Instagram Business)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/social/meta/callback
# Read-only scopes by default. Publishing scopes are added in a later sprint after App Review.
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,instagram_basic

# --- AI gateway (D-075) ---
# Defaults below match ``src/core/config.py``. ``fake`` is the CI/dev provider (no network).
AI_PROVIDER=fake                      # fake | openai_compatible
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=                  # Bearer key — travels only in the Authorization header
AI_DEFAULT_MODEL=gpt-4o-mini
AI_HTTP_TIMEOUT_SECONDS=30
AI_DAILY_TOKEN_BUDGET_PER_BRAND=200000
# Fixed price table per model (USD per 1k tokens) for ``ai_cost_log.estimated_cost_usd``.
# في وضع `platform` يجب أن يحتوي الجدول على `AI_DEFAULT_MODEL` وإلا رُفض كل نداء بـ503
# `ai_model_unpriced` (fail-closed, D-075). A price of "0" is valid; a missing model is not.
AI_PRICE_TABLE_JSON={"gpt-4o-mini":{"prompt_per_1k":"0.00015","completion_per_1k":"0.0006"}}
# سقف المنصة اليومي (USD، نافذة 24 ساعة متحركة) على النداءات المدفوعة من مفتاح المنصة فقط
# (`credential_mode=platform`) — عند بلوغه يُرفض النداء بـ503 `platform_budget_exhausted`.
PLATFORM_DAILY_USD_CAP=25
# مفتاح قتل (D-076) لفحص التسعير فقط: `false` يسمح بنموذج غير مسعَّر (تكلفة NULL) مع WARNING
# عند الإقلاع. مسار الحجز/التسوية في `ai_cost_log` لا يمكن تعطيله.
FEATURE_BUDGET_GUARD_STRICT=true
# مفتاح قتل (D-076) لفرض حدود الباقات (D-073): `false` ⇒ كل علامة «مسموح» دائماً (تبقى الجداول
# ومسارات الإدارة تعمل) ويُسجَّل WARNING واحد عند الإقلاع.
FEATURE_ENTITLEMENTS_ENFORCED=true
# معرّفات المستخدمين (UUID مفصولة بفواصل) المخوّلون على مسارات `/api/v1/admin/*` (C-3).
# فارغ ⇒ كل مسار إداري يُرجع 403 `platform_admin_required` (آمن افتراضاً).
PLATFORM_ADMIN_USER_IDS=
