# ============================================================
# AI Growth OS — Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================

APP_NAME="AI Growth OS"
APP_ENV=development            # development | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Token encryption key (Fernet, urlsafe-base64, 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Database (PostgreSQL 16+ with pgvector — ARCHITECTURE_LOCK D-032)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_growth_os

# Meta Graph API (Facebook / Instagram Business)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v19.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/social/meta/callback
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish,business_management
